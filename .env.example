# 复制为 .env 并填写真实值；.env 勿提交 Git。
# scripts 运行时会自动加载（load-env.sh）。

# 七牛 API
QINIU_AK=你的七牛AccessKey
QINIU_SK=你的七牛SecretKey

# 阿里云 CLB OpenAPI（与 DNS 的 Ali_Key 可同账号或分权子账号）
# 亦支持 ALIBABA_CLOUD_ACCESS_KEY_ID / ALIBABA_CLOUD_ACCESS_KEY_SECRET
# ALIYUN_AK=你的阿里云AccessKeyId
# ALIYUN_SK=你的阿里云AccessKeySecret

# --- DNS 凭据（按 config.yaml 中各证书的 dns_provider 选用）---

# 阿里云 DNS（acme.sh dns_ali；变量名固定为 Ali_Key / Ali_Secret）
# RAM 子账号需 AliyunDNSFullAccess 权限
Ali_Key=你的阿里云AccessKeyId
Ali_Secret=你的阿里云AccessKeySecret

# 腾讯云 DNS（acme.sh dns_tencent；变量名固定为 TENCENT_SECRET_ID / TENCENT_SECRET_KEY）
# 腾讯云 CAM 子账号需 DNS 解析读写权限（如 QcloudDNSPodFullAccess 或自定义 DNS 策略）
# TENCENT_SECRET_ID=你的腾讯云SecretId
# TENCENT_SECRET_KEY=你的腾讯云SecretKey

# DNSPod（acme.sh dns_dp；独立 DNSPod 账号，变量名固定为 DP_Id / DP_Key）
# DP_Id=你的DNSPodID
# DP_Key=你的DNSPodToken

# Cloudflare（acme.sh dns_cf；二选一）
# CF_Token=你的CloudflareAPIToken
# CF_Email=你的Cloudflare邮箱
# CF_Key=你的CloudflareGlobalAPIKey

# --- 告警（可选）---

# 钉钉
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx

# 飞书（若 notify.provider 为 feishu）
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
