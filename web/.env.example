# MySQL 5.7+
DATABASE_URL=mysql+pymysql://qcert:secret@127.0.0.1:3306/qiniu_cert_web?charset=utf8mb4
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=rootsecret

# Web
SECRET_KEY=change-me-32bytes-minimum-random-hex
WEB_MASTER_KEY=base64-encoded-32-bytes
WEB_DATA_ROOT=
PROJECT_ROOT=
ACME_CA=letsencrypt_test
DEFAULT_RENEW_DAYS=15
SESSION_MAX_AGE=604800
LOG_LEVEL=INFO
STALE_JOB_MINUTES=15

# 可选平台告警
NOTIFY_WEBHOOK=
NOTIFY_PROVIDER=dingtalk
